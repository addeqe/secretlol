# Used by local scripts. GitHub needs the same values in Secrets/Variables.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
# Upstream client's default online context: Willys Kungsbacka Hede.
WILLYS_STORE_ID=2110
CATALOG_API_TOKEN=
# Prevent costly/unbounded work. Limits stop a run; they never truncate/publish it.
MAX_WILLYS_REQUESTS=300
MAX_RUN_MINUTES=55
MAX_PRODUCTS=20000
HISTORY_DAYS=90
# This run's limits, including SQLite/D1 index writes. Other account use also counts.
MAX_D1_ROWS_WRITTEN=80000
MAX_D1_SIZE_MB=400
# Optional Coop/ICA extension. Keep disabled during local preparation.
COOP_DATABASE_ID=
ICA_DATABASE_ID=
COOP_PUBLIC_SUBSCRIPTION_KEY=
RETAILERS_CLOUD_ENABLED=false
RETAILERS_LIVE_ENABLED=false
